{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slides"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layout",
          "title",
          "bullets",
          "sources",
          "architectureArtifactId"
        ],
        "properties": {
          "layout": {
            "enum": [
              "cover",
              "context",
              "solution",
              "architecture",
              "roadmap",
              "risks"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 90
          },
          "bullets": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "architectureArtifactId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
