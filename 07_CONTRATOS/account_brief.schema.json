{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_id",
    "account_name",
    "as_of",
    "opportunities",
    "stale_count",
    "next_steps",
    "assumptions",
    "source_refs"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "account_name": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "stage",
          "status",
          "amount_eur",
          "probability",
          "last_contact_date",
          "last_contact_days",
          "stale",
          "next_step"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "stage": { "type": "string" },
          "status": { "enum": ["open", "stale", "won", "lost"] },
          "amount_eur": { "type": "number", "minimum": 0 },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "last_contact_date": { "type": "string", "format": "date" },
          "last_contact_days": { "type": "integer", "minimum": 0 },
          "stale": { "type": "boolean" },
          "next_step": { "type": "string" }
        }
      }
    },
    "stale_count": {
      "type": "integer",
      "minimum": 0
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner_role", "source_ref"],
        "properties": {
          "action": { "type": "string" },
          "owner_role": { "type": "string" },
          "source_ref": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
