{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "tasks",
    "assumptions"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "agent",
          "instruction",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,40}$"
          },
          "agent": {
            "enum": [
              "crm",
              "consultant",
              "architect",
              "offers",
              "designer",
              "delivery",
              "billing"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "requiresApproval": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
