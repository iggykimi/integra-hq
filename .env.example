# Illustrative names only. Adapt to implementation. Never expose in browser.
# Provider mode: mock | azure-openai | openai | anthropic
MODEL_PROVIDER=mock

# Azure OpenAI / Microsoft Foundry (confirmed baseline: gpt-6-luna on Integra subscription)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_DEFAULT=gpt-6-luna
# Optional per-role overrides (leave empty to reuse AZURE_OPENAI_DEPLOYMENT_DEFAULT)
AZURE_OPENAI_DEPLOYMENT_DIRECTOR=
AZURE_OPENAI_DEPLOYMENT_SPECIALIST=
AZURE_OPENAI_DEPLOYMENT_FAST=

# Storage & execution limits (demo target: 150-180s full cycle)
ARTIFACT_STORAGE=local
RUN_TIMEOUT_MS=180000
TASK_TIMEOUT_MS=45000
MAX_CONCURRENT_TASKS=2
MAX_REPLAN_ATTEMPTS=1
